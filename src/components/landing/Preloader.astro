---
// Markup only: `runPreloader` (src/scripts/preloader.ts) drives the counter and the exit.
import { createRandom } from "../../three/utils";

// CSS 3D replica of the hero cube (src/three/objects/dishubCore.ts): same bricks, seed, delays and
// pops, so the loader plays the same assembly without waiting for Three.js.
const UNIT = 30;
const BRICK = 0.56;
const STEP = BRICK + 0.07;
const POP_PERIOD = 1.6;
const POPS = 6;

const random = createRandom(23);
const px = (value: number) => `${(value * UNIT).toFixed(2)}px`;
// Three.js is y-up; CSS is y-down.
const translate = ([x, y, z]: number[]) => `translate3d(${px(x)}, ${px(-y)}, ${px(z)})`;
const unit = (vector: number[]) => {
  const length = Math.hypot(...vector) || 1;
  return vector.map((value) => value / length);
};

const bricks: { home: number[]; from: number[]; normal: number[]; layer: number; delay: number; pops: number[] }[] = [];
for (let x = 0; x < 3; x++) {
  for (let y = 0; y < 3; y++) {
    for (let z = 0; z < 3; z++) {
      if (x === 1 && y === 1 && z === 1) continue;
      const home = [(x - 1) * STEP, (y - 1) * STEP, (z - 1) * STEP];
      const normal = y === 2 ? [0, 1, 0] : x === 0 ? [-1, 0, 0] : z === 2 ? [0, 0, 1] : [0, 0, 0];
      const theta = random() * Math.PI * 2;
      const phi = Math.acos(2 * random() - 1);
      const jitter = [Math.sin(phi) * Math.cos(theta), Math.cos(phi), Math.sin(phi) * Math.sin(theta)].map((value) => value * 0.6);
      const from = unit(unit(home).map((value, axis) => value + jitter[axis])).map((value, axis) => value * 3.2 + home[axis]);
      bricks.push({ home, from, normal, layer: y, delay: 0.35 + y * 0.42 + (x + z) * 0.06 + random() * 0.08, pops: [] });
    }
  }
}

// One surface brick pops per period once it has landed (assembly lasts 0.9 s).
const surface = bricks.filter((brick) => brick.normal.some(Boolean));
for (let index = 0; index < POPS; index++) {
  const brick = surface[Math.floor(createRandom(index + 101)() * surface.length)];
  if (index * POP_PERIOD >= brick.delay + 0.9) brick.pops.push(index * POP_PERIOD);
}
---

<div class="lp-loader" role="status" aria-live="polite" aria-label="Cargando disHub, 0 %">
  <div class="lp-loader__inner">
    <img class="lp-loader__logo" src="/DIS.svg" alt="" width="132" height="44" />

    <div class="lp-loader__object" aria-hidden="true">
      <svg class="lp-loader__frame" viewBox="-80 -80 160 160">
        <path class="lp-loader__plate" d="M0-73.5 63.65-36.75v73.5L0 73.5-63.65 36.75v-73.5Z" />
        <path class="lp-loader__ring" d="M0-66.15 57.29-33.08v66.15L0 66.15-57.29 33.08v-66.15Z" />
        <path class="lp-loader__edge" d="M0-75.7 65.56-37.85v75.7L0 75.7-65.56 37.85v-75.7Z" />
      </svg>
      <div class="lp-loader__sway-x">
        <div class="lp-loader__sway-y">
          <div class="lp-loader__cube">
            {bricks.map((brick) => (
              <div
                class="lp-loader__brick"
                style={`--home: ${translate(brick.home)}; --from: ${translate(brick.from)}; --delay: ${brick.delay.toFixed(3)}s; --wave-delay: ${(brick.layer / 0.6 - 0.357).toFixed(3)}s`}
              >
                <div
                  class="lp-loader__pop"
                  style={brick.pops.length
                    ? `--out: ${translate(brick.normal.map((value) => value * 0.2))}; animation-delay: ${brick.pops.map((time) => `${time}s`).join(", ")}; animation-name: ${brick.pops.map(() => "lpBrickPop").join(", ")}`
                    : undefined}
                >
                  <i class="lp-loader__side lp-loader__side--left" />
                  <i class="lp-loader__side lp-loader__side--top" />
                  <i class="lp-loader__side lp-loader__side--right" />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="lp-loader__meta" aria-hidden="true">
      <p class="lp-loader__message">Conectando activos</p>
      <p class="lp-loader__count">000<span>%</span></p>
    </div>
    <div class="lp-loader__bar" aria-hidden="true">
      <span style="transform: scaleX(0)" />
    </div>
  </div>
</div>
