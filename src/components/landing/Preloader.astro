---
// Markup only: `runPreloader` (src/scripts/preloader.ts) drives the counter and the exit.
---

<div class="lp-loader" role="status" aria-live="polite" aria-label="Cargando disHub, 0 %">
  <div class="lp-loader__inner">
    <img class="lp-loader__logo" src="/DIS.svg" alt="" width="132" height="44" />

    <div class="lp-loader__object" aria-hidden="true">
      <span />
      <span />
      <span />
      <span />
    </div>

    <div class="lp-loader__meta" aria-hidden="true">
      <p class="lp-loader__message">Conectando activos</p>
      <p class="lp-loader__count">000<span>%</span></p>
    </div>
    <div class="lp-loader__bar" aria-hidden="true">
      <span style="transform: scaleX(0)" />
    </div>
  </div>
  <p class="lp-loader__foot" aria-hidden="true">Metodología Brickflow · Bogotá</p>
</div>
