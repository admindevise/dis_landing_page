---
interface Props {
  numbered?: boolean;
}

const { numbered = false } = Astro.props;

// Node centres on the 220 px ring: left, top, right, bottom (clockwise from the left).
const nodes = [
  { left: -20, top: 90, size: 40, className: "bf-fdt__node--solid", delay: 7.5 },
  { left: 96, top: -14, size: 28, className: "", delay: 0 },
  { left: 192, top: 82, size: 56, className: "bf-fdt__node--deep", delay: 2.5 },
  { left: 96, top: 206, size: 28, className: "", delay: 5 }
];
const chevrons = [[183, 27, 45], [183, 183, 135], [27, 183, 225], [27, 27, 315]];
---

<div class="bf-fdt__ring-wrap">
  <span class="bf-fdt__dome" />
  <span class="bf-fdt__ring bf-spin" />
  <svg class="bf-fdt__axis" viewBox="0 0 220 8"><path d="M0 4 H220" /></svg>
  {chevrons.map(([left, top, rotate]) => (
    <svg class="bf-fdt__chevron" viewBox="0 0 10 10" style={`left: ${left}px; top: ${top}px; transform: rotate(${rotate}deg)`}><path d="M2 1 L8 5 L2 9 Z" /></svg>
  ))}
  <span class="bf-fdt__lane">Dirección · FDT</span>
  <span class="bf-fdt__lane bf-fdt__lane--operation">Operación · FDE</span>
  <span class="bf-fdt__orbit bf-spin"><span /></span>
  {nodes.map((node, index) => (
    <span style={`left: ${node.left}px; top: ${node.top}px; width: ${node.size}px; height: ${node.size}px`}>
      <span class="bf-fdt__ripple bf-ripple" style={`animation-delay: ${node.delay}s`} />
      <span class:list={["bf-fdt__node", node.className]}>{numbered ? index + 1 : null}</span>
    </span>
  ))}
</div>
