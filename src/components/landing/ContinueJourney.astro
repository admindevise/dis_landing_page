---
interface Props {
  /** First path segment of the current page. */
  current: string;
}

const JOURNEY = [
  { key: "nosotros", number: "01", label: "Nosotros", to: "/", description: "Conozca disHub y la manera en que abordamos los retos operativos." },
  { key: "metodologia", number: "03", label: "Metodología Brickflow", to: "/metodologia", description: "Conozca los roles y etapas que llevan la IA del diagnóstico a producción." },
  { key: "soluciones", number: "09", label: "Casos de estudio", to: "/soluciones", description: "Conozca casos de estudio de los productos diseñados bajo la metodología Brickflow para responder a las necesidades específicas de su organización." },
  { key: "historia", number: "12", label: "Trayectoria", to: "/historia", description: "Una experiencia construida junto a organizaciones del sector." },
  { key: "contacto", number: "15", label: "Contacto", to: "/contacto", description: "Conversemos sobre los retos de su organización." }
];

const foundIndex = JOURNEY.findIndex((item) => item.key === Astro.props.current);
const currentIndex = foundIndex === -1 ? 0 : foundIndex;
const current = JOURNEY[currentIndex];
const next = JOURNEY[(currentIndex + 1) % JOURNEY.length];
const isLastStep = currentIndex === JOURNEY.length - 1;
const shortcuts = JOURNEY.filter((item) => item.key !== current.key && item.key !== next.key);
---

<section class="lp-continue" aria-labelledby="continue-title">
  <div class="lp-container">
    <div class="lp-continue__topline">
      <p class="lp-eyebrow">
        <span class="lp-eyebrow__index">{next.number}</span>
        <span class="lp-eyebrow__rule" aria-hidden="true" />
        Continúe el recorrido
      </p>
      <div class="lp-continue__progress" aria-label={`Página ${currentIndex + 1} de ${JOURNEY.length}`}>
        <span>{String(currentIndex + 1).padStart(2, "0")} / {String(JOURNEY.length).padStart(2, "0")}</span>
        <span class="lp-continue__segments" aria-hidden="true">
          {JOURNEY.map((_, index) => <i class={index <= currentIndex ? "is-active" : undefined} />)}
        </span>
      </div>
    </div>

    <div class="lp-continue__main">
      <div class="lp-continue__copy">
        <p class="lp-continue__label">{isLastStep ? "Volver al inicio" : "Siguiente"}</p>
        <h2 id="continue-title" class="lp-band__statement">{next.label}</h2>
        <p class="lp-continue__description">{next.description}</p>
      </div>
      <a class="lp-continue__next" href={next.to} aria-label={`${isLastStep ? "Volver a" : "Continuar a"} ${next.label}`}>
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <nav class="lp-continue__shortcuts" aria-label="Vaya directamente a">
      <span class="lp-continue__shortcuts-label">O vaya directamente a</span>
      {shortcuts.map((shortcut) => (
        <a href={shortcut.to}>
          <span>{shortcut.number}</span>
          {shortcut.label}
        </a>
      ))}
    </nav>
  </div>
</section>
