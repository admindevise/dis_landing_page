---
import { FIELDS } from "../../constants/content";

// The dot takes each product's brand colour once it is chosen.
const INTERESTS = [
  { value: "brickflow", label: "BrickFlow", desc: "Diagnóstico y Arquitectura a la Medida", color: "#4fd8d8" },
  { value: "devise-trust", label: "Devise Trust", desc: "Control y auditoría con IA para vehículos de inversión", color: "#8b7cf0" },
  { value: "devise-marketplace", label: "Devise Marketplace", desc: "Distribución B2B2C y canales de liquidez", color: "#2bc4cf" },
  { value: "devise-pulse", label: "Devise Pulse", desc: "Agente CFO y ejecución operativa vía WhatsApp", color: "#ff7a5c" },
  { value: "devise-tokenize", label: "Devise Tokenize", desc: "Tokenización de activos y fondos", color: "#fbb833" },
  { value: "valuo", label: "Valuo", desc: "Valoración e inteligencia inmobiliaria", color: "#10b981" },
  { value: "otro", label: "Otro reto operativo", desc: "Cuéntanos tu reto y te orientamos a la ruta de mayor impacto.", color: "#b0c4d4" }
];
const INTEREST_HINT = "Elige el área que mejor describe tu reto.";
---

<form novalidate aria-describedby="form-status" class="lp-form">
  {FIELDS.map((field) => (
    <div class="lp-field">
      <label for={field.name}>{field.label}</label>
      <input
        id={field.name}
        type={field.type as astroHTML.JSX.HTMLInputTypeAttribute}
        name={field.name}
        autocomplete={field.ac}
        maxlength={field.max}
        aria-invalid="false"
        data-field={field.name}
      />
      <p id={`err-${field.name}`} class="lp-field__error" hidden />
    </div>
  ))}

  <fieldset class="lp-field lp-field--full lp-interest">
    <legend>Área de interés</legend>
    <div class="lp-interest__options">
      {INTERESTS.map((interest) => (
        <label class="lp-chip" style={`--c: ${interest.color}`}>
          <input type="radio" name="interes" value={interest.value} aria-invalid="false" data-field="interes" data-desc={interest.desc} />
          <span class="lp-chip__dot" aria-hidden="true" />
          {interest.label}
        </label>
      ))}
    </div>
    <p class="lp-interest__desc" data-hint={INTEREST_HINT}>{INTEREST_HINT}</p>
    <p id="err-interes" class="lp-field__error" hidden />
  </fieldset>

  <div class="lp-field lp-field--full">
    <label for="mensaje">Mensaje</label>
    <textarea
      id="mensaje"
      name="mensaje"
      maxlength="1000"
      aria-invalid="false"
      data-field="mensaje"
      placeholder="Describe brevemente el proceso, cuello de botella o reto que quieres resolver."
    />
    <p id="err-mensaje" class="lp-field__error" hidden />
  </div>

  <label class="lp-check">
    <input type="checkbox" aria-invalid="false" data-field="consent" />
    <span>
      Autorizo el tratamiento de mis datos personales conforme a la <a href="/politica-privacidad">Política de privacidad y tratamiento de datos personales</a> y a la Ley 1581 de 2012.
    </span>
  </label>
  <p id="err-consent" class="lp-field__error lp-field--full" hidden />

  <div class="lp-form__footer">
    <button type="submit" class="lp-btn lp-btn--primary lp-form__submit">
      <span class="lp-form__submit-label">Enviar mensaje</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
    </button>
    <p id="form-status" role="status" class="lp-form__status" hidden />
  </div>

  <input
    type="text"
    name="web"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="lp-form__honeypot"
    data-field="web"
  />
</form>

<div role="status" class="lp-form__done" hidden>
  <span class="lp-form__check" aria-hidden="true">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5" /></svg>
  </span>
  <h3>Recibimos tu mensaje.</h3>
  <p>Gracias por contactarnos. Nuestro equipo te responderá al correo indicado en menos de 24 horas.</p>
  <button type="button" class="lp-btn lp-btn--ghost">Enviar otro mensaje</button>
</div>

<script>
  import { CONTACT_DETAILS, SITE, type FormData } from "../../constants/content";
  import { onPageLoad } from "../../lib/lifecycle";

  type Errors = Partial<Record<keyof FormData, string>>;

  onPageLoad(() => {
    const form = document.querySelector<HTMLFormElement>("form.lp-form");
    if (form) initContactForm(form);
  });

  function initContactForm(form: HTMLFormElement) {
    const done = form.nextElementSibling as HTMLElement;
    const status = form.querySelector<HTMLElement>("#form-status")!;
    const submit = form.querySelector<HTMLButtonElement>(".lp-form__submit")!;
    const submitLabel = submit.querySelector<HTMLElement>(".lp-form__submit-label")!;
    const interestDesc = form.querySelector<HTMLElement>(".lp-interest__desc")!;
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-field]"));
    const fieldName = (field: Element) => (field as HTMLElement).dataset.field as keyof FormData;
    let sending = false;
    let lastSend = 0;

    function readForm(): FormData {
      const values: Record<string, string | boolean> = {};
      fields.forEach((field) => {
        const name = fieldName(field);
        if (field instanceof HTMLInputElement && field.type === "radio") values[name] = field.checked ? field.value : (values[name] ?? "");
        else values[name] = field instanceof HTMLInputElement && field.type === "checkbox" ? field.checked : field.value;
      });
      return values as unknown as FormData;
    }

    function validate(values: FormData) {
      const errors: Errors = {};
      if (values.nombre.trim().length < 3) errors.nombre = "Escribe tu nombre completo.";
      if (values.empresa.trim().length < 2) errors.empresa = "Escribe el nombre de tu empresa.";
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(values.email.trim())) errors.email = "Escribe un correo electrónico válido.";
      if (values.telefono && !/^[+\d\s()-]{7,20}$/.test(values.telefono)) errors.telefono = "Escribe un número telefónico válido.";
      if (!values.interes) errors.interes = "Selecciona una opción.";
      if (values.mensaje.trim().length < 20) errors.mensaje = "Cuéntanos un poco más: el mensaje debe tener al menos 20 caracteres.";
      if (!values.consent) errors.consent = "Para continuar, autoriza el tratamiento de tus datos personales.";
      return errors;
    }

    function setError(name: keyof FormData, error?: string) {
      const message = form.querySelector<HTMLElement>(`#err-${name}`);
      if (!message) return;
      // Radio groups share one name: mark every option.
      fields.filter((item) => fieldName(item) === name).forEach((field) => {
        field.setAttribute("aria-invalid", String(Boolean(error)));
        if (error) field.setAttribute("aria-describedby", `err-${name}`);
        else field.removeAttribute("aria-describedby");
      });
      message.textContent = error ?? "";
      message.hidden = !error;
    }

    function setStatus(text: string) {
      status.textContent = text;
      status.hidden = !text;
      status.classList.toggle("is-error", text.startsWith("Hay"));
    }

    function setSending(value: boolean) {
      sending = value;
      submit.disabled = value;
      submitLabel.textContent = value ? "Enviando…" : "Enviar mensaje";
    }

    function setSent(sent: boolean) {
      form.hidden = sent;
      done.hidden = !sent;
    }

    function showInterest(desc?: string) {
      interestDesc.textContent = desc ?? interestDesc.dataset.hint!;
      interestDesc.classList.toggle("is-chosen", Boolean(desc));
    }

    fields.forEach((field) => {
      field.addEventListener(field.type === "checkbox" || field.type === "radio" ? "change" : "input", () => {
        setError(fieldName(field));
        if (field.type === "radio") showInterest(field.dataset.desc);
      });
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (sending) return;

      const values = readForm();
      if (values.web) {
        setSent(true);
        return;
      }

      const errors = validate(values);
      fields.forEach((field) => setError(fieldName(field), errors[fieldName(field)]));
      const count = Object.keys(errors).length;
      if (count) {
        setStatus(`Hay ${count} ${count === 1 ? "campo por revisar" : "campos por revisar"}.`);
        return;
      }

      if (lastSend && Date.now() - lastSend < 30000) {
        setStatus("Espera unos segundos antes de enviar de nuevo.");
        return;
      }
      lastSend = Date.now();
      setSending(true);
      setStatus("Enviando…");

      const clean = (value: string) => value.trim().replace(/[<>]/g, "").slice(0, 1000);
      const payload = Object.fromEntries(
        Object.entries(values)
          .filter(([key]) => key !== "web")
          .map(([key, value]) => [key, typeof value === "string" ? clean(value) : value])
      );

      try {
        if (SITE.contactEndpoint.startsWith("http")) {
          const response = await fetch(SITE.contactEndpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          if (!response.ok) throw new Error("Contact request failed");
        } else {
          await new Promise((resolve) => setTimeout(resolve, 700));
        }
        setSent(true);
        setSending(false);
        setStatus("");
      } catch {
        setSending(false);
        setStatus(`No pudimos enviar tu mensaje. Intenta de nuevo o escríbenos a ${CONTACT_DETAILS.email}.`);
      }
    });

    done.querySelector("button")!.addEventListener("click", () => {
      form.reset();
      fields.forEach((field) => setError(fieldName(field)));
      showInterest();
      setStatus("");
      setSent(false);
    });
  }
</script>
