---
import { CONTACT_DETAILS, SITE, SOLUTIONS } from "../../constants/content";

const footerSolutions = SOLUTIONS.filter((solution) => {
  if (solution.key === "ai") return false;
  const url = SITE.links[solution.key as keyof typeof SITE.links];
  return /^https?:\/\//.test(url) && !url.includes("[[");
});

const companyLinks = [
  { label: "Nosotros", href: "/nosotros" },
  { label: "Metodología Brickflow", href: "/metodologia" },
  { label: "Trayectoria", href: "/historia" },
  { label: "Contacto", href: "/contacto" }
];

const legalLinks = [
  { label: "Privacidad y datos personales", href: "/politica-privacidad", external: false }
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      {/* Branding */}
      <div class="footer-brand">
        <a href="/" aria-label="disHub, volver al inicio" class="footer-logo">
          <img src="/DIS.svg" alt="disHub" width="110" height="37" />
        </a>
        <p class="footer-text">
          Digital Investment Systems S.A.S.<br />
          NIT 901.783.251-1<br />
          {CONTACT_DETAILS.address}
        </p>
        <p class="footer-text">
          <a href={`mailto:${CONTACT_DETAILS.email}`} class="footer-contact">{CONTACT_DETAILS.email}</a><br />
          <a href={`tel:${CONTACT_DETAILS.phone.replace(/\s/g, "")}`} class="footer-contact">{CONTACT_DETAILS.phone}</a>
        </p>
      </div>

      {/* Products */}
      {footerSolutions.length > 0 && (
        <div>
          <h4 class="footer-heading">Soluciones</h4>
          <ul class="footer-list">
            {footerSolutions.map((solution) => (
              <li>
                <a href={SITE.links[solution.key as keyof typeof SITE.links]} target="_blank" rel="noopener noreferrer" class="footer-link">
                  {solution.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {/* Company */}
      <div class="footer-company-links">
        <h4 class="footer-heading">Empresa</h4>
        <ul class="footer-list">
          {companyLinks.map((item) => (
            <li>
              <a href={item.href} class="footer-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      {/* Legal */}
      <div>
        <h4 class="footer-heading">Legal</h4>
        <ul class="footer-list">
          {legalLinks.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class="footer-link"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Bottom */}
    <div class="footer-bottom">
      <p class="footer-copy">
        © 2026 Digital Investment Systems S.A.S. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    background: rgb(15 28 39 / 0.7);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    border-top: 1px solid rgb(255 255 255 / 0.08);
    padding: 64px var(--lp-gutter, 24px) 32px;
    color: #B0C4D4;
  }

  .footer-inner {
    width: 100%;
    max-width: var(--lp-max, 1240px);
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 48px;
    margin-bottom: 48px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer-logo img {
    display: block;
    object-fit: contain;
  }

  .footer-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: #B0C4D4;
  }

  .footer-contact,
  .footer-contact:hover {
    color: inherit;
  }

  .footer-heading {
    margin: 0 0 16px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    font-family: 'Outfit', sans-serif;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-link {
    font-size: 13px;
    color: #B0C4D4;
    text-decoration: none;
    transition: color 200ms;
  }

  .footer-link:hover {
    color: #4FD8D8;
  }

  .footer-bottom {
    border-top: 1px solid rgb(255 255 255 / 0.05);
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    text-align: center;
  }

  .footer-copy {
    margin: 0;
    font-size: 12px;
    color: rgb(176 196 212 / 0.6);
  }
</style>
