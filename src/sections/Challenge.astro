---
import SectionHeading from "../components/landing/SectionHeading.astro";
import { PROBLEMS } from "../constants/content";
import { pad } from "../lib/tabs";
---

<section id="desafio" class="lp-section lp-tone-ink lp-challenge" data-screen-label="Desafío" aria-labelledby="desafio-title">
  <div class="lp-container lp-challenge__grid">
    <div class="lp-challenge__aside">
      <div class="lp-challenge__sticky">
        <SectionHeading
          eyebrow="El desafío"
          titleId="desafio-title"
          title={["Las operaciones", "complejas requieren", "soluciones que", "comprendan su contexto."]}
          accent={[2]}
          lead="A medida que una operación crece, surgen sistemas desconectados, decisiones que dependen de personas específicas y procesos que dejan de ser escalables. En ese punto inicia nuestro diagnóstico."
        />
        <div class="lp-challenge__counter" aria-hidden="true">
          <p class="lp-challenge__numbers">
            <span class="lp-challenge__current">{pad(1)}</span>
            <span class="lp-challenge__total">/ {pad(PROBLEMS.length)}</span>
          </p>
          <span class="lp-challenge__track"><span style="transform: scaleX(0)" /></span>
          <p class="lp-challenge__label">{PROBLEMS[0].t}</p>
        </div>
      </div>
    </div>

    <ol class="lp-challenge__list">
      {PROBLEMS.map((problem, index) => (
        <li class:list={["lp-problem", index === 0 && "is-current"]} data-reveal>
          <div class="lp-problem__head">
            <span class="lp-problem__num">{pad(index + 1)}</span>
            <span class="lp-problem__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={problem.icon} /></svg>
            </span>
          </div>
          <h3 class="lp-problem__title">{problem.t}</h3>
          <p class="lp-problem__desc">{problem.d}</p>
          <p class="lp-problem__effect"><span>Impacto</span>{problem.c}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { PROBLEMS } from "../constants/content";
  import { onAbort, onPageLoad } from "../lib/lifecycle";
  import { pad } from "../lib/tabs";

  onPageLoad((signal) => {
    const clamp = (value: number) => Math.min(1, Math.max(0, value));
    const section = document.getElementById("desafio");
    if (!section) return;
    const list = section.querySelector<HTMLElement>(".lp-challenge__list")!;
    const problems = list.querySelectorAll<HTMLElement>(".lp-problem");
    const current = section.querySelector<HTMLElement>(".lp-challenge__current")!;
    const track = section.querySelector<HTMLElement>(".lp-challenge__track span")!;
    const label = section.querySelector<HTMLElement>(".lp-challenge__label")!;
    let frame = 0;

    // Steps advance while the list crosses the middle of the viewport.
    const measure = () => {
      frame = 0;
      const rect = list.getBoundingClientRect();
      const progress = clamp((window.innerHeight * 0.55 - rect.top) / rect.height);
      const active = Math.min(PROBLEMS.length - 1, Math.floor(progress * PROBLEMS.length));
      current.textContent = pad(active + 1);
      track.style.transform = `scaleX(${Math.round(progress * 1000) / 1000})`;
      label.textContent = PROBLEMS[active].t;
      problems.forEach((problem, index) => {
        problem.classList.toggle("is-current", index === active);
        problem.classList.toggle("is-past", index < active);
      });
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(measure);
    };

    measure();
    window.addEventListener("scroll", schedule, { passive: true, signal });
    window.addEventListener("resize", schedule, { signal });
    onAbort(signal, () => cancelAnimationFrame(frame));
  });
</script>
