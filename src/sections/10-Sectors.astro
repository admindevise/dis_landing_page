---
import SectionHeading from "../components/landing/SectionHeading.astro";
import { SECTORS } from "../constants/content";
import { pad } from "../lib/tabs";
---

<section id="sectores" class="lp-section lp-panel lp-tone-paper lp-sectors" data-screen-label="11 Sectores" aria-labelledby="sectores-title">
  <div class="lp-container">
    <div class="lp-sectors__head">
      <SectionHeading index="11" eyebrow="Sectores" titleId="sectores-title" title={["Del sector financiero", "a operaciones de alta complejidad."]} />
      <p class="lp-lead" data-reveal>
        Nuestra experiencia se originó en el sector financiero e inmobiliario. La metodología es aplicable a toda operación con regulación, múltiples actores, información sensible y necesidad de evolucionar.
      </p>
    </div>
    <ul class="lp-sectors__list">
      {SECTORS.map((sector, index) => (
        <li class="lp-sector" data-reveal style={`--d: ${index}`}>
          <span class="lp-sector__num">{pad(index + 1)}</span>
          <h3 class="lp-sector__title">{sector.t}</h3>
          <p class="lp-sector__desc">{sector.d}</p>
          <span class="lp-sector__icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={sector.icon} /></svg>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
