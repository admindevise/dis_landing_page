---
import DisHubSymbol from "../components/landing/brickflow/DisHubSymbol.astro";
import SectionHeading from "../components/landing/SectionHeading.astro";
import { BF_COMPARE, BF_FRAMEWORKS, BF_PROFILES } from "../constants/content";

const criterion = 0;
const framework = 0;
const pair = BF_COMPARE[criterion];
const selectedFramework = BF_FRAMEWORKS[framework];
const compareTargets = ["dato", "modelo", "modelo", "bitacora", "perimetro", "bitacora"];

// Rings from inner (0) to outer (3); pills sit on the crown of each ring.
const rings = [
  { size: 180, duration: 40, reverse: true },
  { size: 300, duration: 55, reverse: false },
  { size: 420, duration: 70, reverse: true },
  { size: 540, duration: 90, reverse: false }
];
const pillTops = [193, 133, 73, 13];
---

<section id="comparativo" class="lp-section lp-tone-ink bf bf-compare-section" data-screen-label="08 Comparativo" aria-labelledby="bf-compare-title">
  <div class="lp-container">
    <SectionHeading index="08" eyebrow="Comparativo" titleId="bf-compare-title" title={["La misma potencia de vanguardia.", "Bajo tus propias reglas de control."]} accent={[1]} />
    <div class="bf-compare__controls" data-reveal>
      <div class="bf-compare__controls-label">Compara por dimensión <span class="bf-compare__counter" aria-live="polite">1 / {BF_COMPARE.length}</span></div>
      <div class="bf-chips" role="tablist" aria-label="Criterios">
        {BF_COMPARE.map((row, index) => (
          <button id={`crit-tab-${index}`} type="button" role="tab" data-target={compareTargets[index]} aria-selected={criterion === index} aria-controls="crit-panel-generic crit-panel-brickflow" tabindex={criterion === index ? 0 : -1}>
            {row.k}
          </button>
        ))}
      </div>
    </div>
    <div class="bf-compare" aria-label="Comparación de perímetros de datos" role="group" data-target={compareTargets[criterion]} data-reveal>
      <article class="bf-compare__card">
        <h3>IA genérica, sin diseño</h3>
        <div class="bf-compare__row">
          <div class="bf-perimeter bf-perimeter--loose">
            <span class="bf-tag"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /></svg>Tu perímetro</span>
            <strong class="bf-token" data-node="dato" data-active="true"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14a9 3 0 0 0 18 0V5M3 12a9 3 0 0 0 18 0" /></svg>Dato</strong>
          </div>
          <div class="bf-compare__leak"><span>Sale</span><svg class="bf-compare__arrow" width="48" height="12" viewBox="0 0 48 12" fill="none" aria-hidden="true"><path class="bf-flow" d="M0 6 H40" /><path d="M39 1.5 L47 6 L39 10.5 Z" /></svg></div>
          <span class="bf-compare__external"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" /></svg>Servidores de terceros</span>
        </div>
        <div id="crit-panel-generic" class="bf-compare__verdict bf-compare__verdict--generic" role="tabpanel" aria-labelledby={`crit-tab-${criterion}`} aria-live="polite">
          <div class="bf-compare__verdict-heading"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M8 12h8" /></svg><span class="bf-compare__badge">El dato sale</span></div>
          <p><span class="sr-only">IA genérica: </span>{pair.generic}</p>
        </div>
      </article>
      <article class="bf-compare__card bf-compare__card--brickflow">
        <h3>Brickflow: arquitectura a la medida</h3>
        <div class="bf-perimeter" data-perimeter-active="false">
          <span class="bf-tag"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /></svg>Tu perímetro</span>
          <div class="bf-perimeter__flow">
            <strong class="bf-token" data-node="dato" data-active="true"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14a9 3 0 0 0 18 0V5M3 12a9 3 0 0 0 18 0" /></svg>Dato</strong>
            <svg class="bf-compare__arrow" width="36" height="12" viewBox="0 0 36 12" fill="none" aria-hidden="true"><path class="bf-flow" d="M0 6 H28" /><path d="M27 1.5 L35 6 L27 10.5 Z" /></svg>
            <strong class="bf-token" data-node="modelo" data-active="false"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2" /><rect x="9" y="9" width="6" height="6" /><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" /></svg>Modelo</strong>
            <svg class="bf-compare__arrow" width="36" height="12" viewBox="0 0 36 12" fill="none" aria-hidden="true"><path class="bf-flow" d="M0 6 H28" /><path d="M27 1.5 L35 6 L27 10.5 Z" /></svg>
            <strong class="bf-token" data-node="bitacora" data-active="false"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 12h-5M15 8h-5M19 17V5a2 2 0 0 0-2-2H4M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3" /></svg>Bitácora</strong>
          </div>
        </div>
        <div id="crit-panel-brickflow" class="bf-compare__verdict bf-compare__verdict--brickflow" role="tabpanel" aria-labelledby={`crit-tab-${criterion}`} aria-live="polite">
          <div class="bf-compare__verdict-heading"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m8.5 12.5 2.5 2.5 4.5-5" /></svg><span class="bf-compare__badge">El dato se queda</span></div>
          <p><span class="sr-only">Brickflow: </span>{pair.us}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<section id="marcos" class="lp-section lp-tone-navy bf" data-screen-label="09 Contexto regulatorio" aria-labelledby="bf-context-title">
  <div class="lp-container">
    <SectionHeading
      index="09"
      eyebrow="Contexto regulatorio"
      titleId="bf-context-title"
      title={["Pensado para los marcos", "que tu comité revisa."]}
      accent={[1]}
      lead="Los acuerdos de confidencialidad nos impiden mostrar logos de clientes. Mostramos lo que sí podemos: el rigor regulatorio, técnico y de auditoría bajo el cual diseñamos para industrias que no pueden permitirse fallar."
    />
    <div class="bf-frameworks" data-reveal>
      <div class="bf-frameworks__visual">
        <div class="bf-canvas" style="height: 340px">
          <div class="bf-canvas__inner" style="width: 600px; height: 340px; --s: 1">
            <div class="bf-dome">
              <div class="bf-dome__sky" aria-hidden="true">
                {rings.map((ring, index) => (
                  <span
                    class:list={["bf-dome__ring bf-spin", framework === index && "is-active"]}
                    style={`width: ${ring.size}px; height: ${ring.size}px; left: ${300 - ring.size / 2}px; top: ${300 - ring.size / 2}px; animation-duration: ${ring.duration}s; animation-direction: ${ring.reverse ? "reverse" : "normal"}; --fill: ${0.06 - index * 0.008}`}
                  />
                ))}
                <span class="bf-dome__orbit bf-spin"><span /></span>
              </div>
              <span class="bf-dome__ground" aria-hidden="true" />
              <span class="bf-dome__entity"><DisHubSymbol />Tu entidad</span>
              {BF_FRAMEWORKS.map((item, index) => (
                <button class="bf-dome__pill" type="button" style={`top: ${pillTops[index]}px`} aria-pressed={framework === index} data-framework={index} data-when="wide">
                  {item.short}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div class="bf-frameworks__tabs" role="group" aria-label="Marcos regulatorios" data-when="compact" hidden>
        {BF_FRAMEWORKS.map((item, index) => ({ item, index })).reverse().map(({ item, index }) => (
          <button type="button" aria-pressed={framework === index} data-framework={index}>
            <span class="bf-tag">{item.tag}</span>{item.t}
          </button>
        ))}
      </div>
      <div class="bf-frameworks__detail bf-in" aria-live="polite">
        <span class="bf-tag">{selectedFramework.tag}</span>
        <h3>{selectedFramework.t}</h3>
        <p>{selectedFramework.d}</p>
      </div>
    </div>
    <div class="bf-marquee" data-reveal>
      <span class="bf-marquee__label">Para quién diseñamos</span>
      <div class="bf-marquee__viewport" aria-hidden="true">
        <div class="bf-marquee__track">
          {[...BF_PROFILES, ...BF_PROFILES].map((profile) => (
            <span class="bf-marquee__item">{profile}</span>
          ))}
        </div>
      </div>
      <ul class="sr-only" aria-label="Sectores para quienes diseñamos">
        {BF_PROFILES.map((profile) => <li>{profile}</li>)}
      </ul>
    </div>
  </div>
</section>

<script>
  import { BF_COMPARE, BF_FRAMEWORKS } from "../constants/content";
  import { fitScale, observeWidth, replay, setOwnText } from "../lib/dom";
  import { onPageLoad } from "../lib/lifecycle";
  import { handleTabKeys, selectTab } from "../lib/tabs";

  onPageLoad((signal) => {
    // Comparison criteria.
    const chips = document.querySelector<HTMLElement>("#comparativo .bf-chips");
    if (!chips) return;
    const chipTabs = chips.querySelectorAll<HTMLButtonElement>("button");
    const compare = document.querySelector<HTMLElement>("#comparativo .bf-compare")!;
    const genericPanel = document.getElementById("crit-panel-generic")!;
    const brickflowPanel = document.getElementById("crit-panel-brickflow")!;
    const counter = document.querySelector<HTMLElement>("#comparativo .bf-compare__counter")!;
    const genericVerdictLabels = ["El dato sale", "Reglas ajenas", "Costo variable", "Sin registro", "Un solo camino", "Evidencia dispersa"];
    const brickflowVerdictLabels = ["El dato se queda", "Reglas propias", "Costo predecible", "Todo registrado", "A tu medida", "Evidencia lista"];
    let criterion = 0;

    function setCriterion(index: number) {
      if (index === criterion) return;
      criterion = index;
      selectTab(chipTabs, index);
      genericPanel.setAttribute("aria-labelledby", `crit-tab-${index}`);
      brickflowPanel.setAttribute("aria-labelledby", `crit-tab-${index}`);
      setOwnText(genericPanel.querySelector("p")!, BF_COMPARE[index].generic);
      setOwnText(brickflowPanel.querySelector("p")!, BF_COMPARE[index].us);
      genericPanel.querySelector<HTMLElement>(".bf-compare__badge")!.textContent = genericVerdictLabels[index];
      brickflowPanel.querySelector<HTMLElement>(".bf-compare__badge")!.textContent = brickflowVerdictLabels[index];
      counter.textContent = `${index + 1} / ${BF_COMPARE.length}`;
      const target = chipTabs[index].dataset.target!;
      compare.dataset.target = target;
      compare.querySelectorAll<HTMLElement>("[data-node]").forEach((node) => node.dataset.active = String(node.dataset.node === target));
      compare.querySelector<HTMLElement>(".bf-perimeter")!.dataset.perimeterActive = String(target === "perimetro");
      replay(genericPanel);
      replay(brickflowPanel);
    }

    chipTabs.forEach((tab, index) => tab.addEventListener("click", () => setCriterion(index)));
    chips.addEventListener("keydown", (event) => handleTabKeys(event, criterion, BF_COMPARE.length, setCriterion, "crit-tab"));

    // Regulatory frameworks dome.
    const frameworks = document.querySelector<HTMLElement>("#marcos .bf-frameworks")!;
    const visual = frameworks.querySelector<HTMLElement>(".bf-frameworks__visual")!;
    const canvas = visual.querySelector<HTMLElement>(".bf-canvas")!;
    const rings = frameworks.querySelectorAll<HTMLElement>(".bf-dome__ring");
    const frameworkButtons = frameworks.querySelectorAll<HTMLButtonElement>("[data-framework]");
    const detail = frameworks.querySelector<HTMLElement>(".bf-frameworks__detail")!;
    let framework = 0;
    let compactDome: boolean | null = null;

    function setFramework(index: number) {
      if (index === framework) return;
      framework = index;
      const selected = BF_FRAMEWORKS[index];
      rings.forEach((ring, ringIndex) => ring.classList.toggle("is-active", ringIndex === index));
      frameworkButtons.forEach((button) => button.setAttribute("aria-pressed", String(Number(button.dataset.framework) === index)));
      detail.querySelector(".bf-tag")!.textContent = selected.tag;
      detail.querySelector("h3")!.textContent = selected.t;
      detail.querySelector("p")!.textContent = selected.d;
      replay(detail);
    }

    frameworkButtons.forEach((button) => button.addEventListener("click", () => setFramework(Number(button.dataset.framework))));

    observeWidth(visual, (width) => {
      const scale = fitScale(width, 600);
      canvas.style.height = `${340 * scale}px`;
      canvas.querySelector<HTMLElement>(".bf-canvas__inner")!.style.setProperty("--s", String(scale));
      const nextCompact = scale < 0.8;
      if (nextCompact === compactDome) return;
      compactDome = nextCompact;
      frameworks.querySelectorAll<HTMLElement>('[data-when="compact"]').forEach((element) => { element.hidden = !nextCompact; });
      frameworks.querySelectorAll<HTMLElement>('[data-when="wide"]').forEach((element) => { element.hidden = nextCompact; });
    }, signal);
  });
</script>
